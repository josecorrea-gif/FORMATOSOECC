<!-- SCRIPT COMPLETO INTEGRADOR Y DE CÁLCULOS DINÁMICOS -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    
    // --- 1. AUTOCOMPLETADO REPRESENTANTE LEGAL -> DUEÑO REAL ---
    const mapCampos = [
        { origen: 'RepLegalNombre', destino: 'DuenioRealNombre' },
        { origen: 'RepLegalDomicilioCalle', destino: 'DuenioRealCalle' },
        { origen: 'RepLegalDomicilioMunicipio', destino: 'DuenioRealMunicipio' },
        { origen: 'RepLegalDomicilioCiudad', destino: 'DuenioRealCiudad' },
        { origen: 'RepLegalDomicilioEstado', destino: 'DuenioRealEstado' },
        { origen: 'RepLegalCP', destino: 'DuenioRealCP' },
        { origen: 'RepLegalTel', destino: 'DuenioRealTel' },
        { origen: 'RepLegalEmail', destino: 'DuenioRealEmail' },
        { origen: 'RepLegalNacionalidad', destino: 'DuenioRealNacionalidad' },
        { origen: 'RepLegalPaisNacimiento', destino: 'DuenioRealPaisNacimiento' },
        { origen: 'RepLegalEntidadNacimiento', destino: 'DuenioRealEntidadNacimiento' },
        { origen: 'RepLegalDocIdentificacion', destino: 'DuenioRealTipoIdentificacion' },
        { origen: 'RepLegalFolioIdentificacion', destino: 'DuenioRealFolioIdentificacion' },
        { origen: 'RepLegalVigenciaIdentificacion', destino: 'DuenioRealVigenciaIdentificacion' },
        { origen: 'RepLegalOcupacion', destino: 'DuenioRealOcupacion' },
        { origen: 'RepLegalRFC', destino: 'DuenioRealRFC' },
        { origen: 'RepLegalCURP', destino: 'DuenioRealCURP' },
        { origen: 'RepLegalFechaNacimiento', destino: 'DuenioRealFechaNacimiento' }
    ];

    mapCampos.forEach(pair => {
        const elOrigen = document.getElementById(pair.origen);
        const elDestino = document.getElementById(pair.destino);
        if (elOrigen && elDestino) {
            const sincronizar = () => { elDestino.value = elOrigen.value; };
            elOrigen.addEventListener('input', sincronizar);
            elOrigen.addEventListener('change', sincronizar);
        }
    });

    // --- 2. VINCULACIÓN DE FIRMAS ---
    const promotorHeader = document.getElementById('PromotorHeader');
    const firmaPromotor = document.getElementById('FirmaPromotorVinculada');
    if (promotorHeader && firmaPromotor) {
        promotorHeader.addEventListener('input', () => { firmaPromotor.value = promotorHeader.value; });
    }

    const repLegalNombre = document.getElementById('RepLegalNombre');
    const firmaUsuario = document.getElementById('FirmaUsuarioVinculada');
    if (repLegalNombre && firmaUsuario) {
        repLegalNombre.addEventListener('input', () => { firmaUsuario.value = repLegalNombre.value; });
    }

    const denominacionSocial = document.getElementById('DenominacionSocial');
    const firmaDenominacion = document.getElementById('FirmaDenominacionVinculada');
    if (denominacionSocial && firmaDenominacion) {
        denominacionSocial.addEventListener('input', () => {
            firmaDenominacion.value = denominacionSocial.value ? `(${denominacionSocial.value})` : '';
        });
    }

    // --- 3. RESTRICCIÓN CAMPOS SOLO NÚMEROS DE OTROS APARTADOS ---
    const camposNumericosGen = document.querySelectorAll(".solo-numeros");
    camposNumericosGen.forEach(input => {
        input.addEventListener("input", (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
        });
    });

    // =========================================================
    // --- 4. MANEJO ESPECIAL PUNTO 5 Y LÍNEA OPERATIVA ---
    // =========================================================

    // A. Forzar campos verdes (OP Promedio) a SOLO ENTEROS
    const camposEnteros = document.querySelectorAll(".solo-enteros");
    camposEnteros.forEach(input => {
        input.addEventListener("input", (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
        });
    });

    // B. Función auxiliar para limpiar y extraer valor numérico
    function parsearMonto(id) {
        const el = document.getElementById(id);
        if (!el || !el.value) return 0;
        const limpio = el.value.toString().replace(/[^0-9.]/g, '');
        return parseFloat(limpio) || 0;
    }

    // C. Formateador dinámico para los recuadros de dinero (Rojos)
    function formatearCampoRojo(input) {
        let val = input.value.replace(/[^0-9.]/g, '');
        if (!val) return;

        const partes = val.split('.');
        if (partes.length > 2) {
            val = partes[0] + '.' + partes.slice(1).join('');
        }

        if (val.includes('.')) {
            const dec = val.split('.')[1];
            if (dec && dec.length > 2) {
                val = parseFloat(val).toFixed(2);
            }
            input.value = val;
        } else {
            const entero = parseInt(val, 10);
            if (!isNaN(entero)) {
                input.value = entero.toLocaleString('es-MX');
            }
        }
    }

    // D. Al salir del campo (Blur), forzar decimales .00
    function fijarDecimalesBlur(input) {
        const num = parsearMonto(input.id);
        if (num > 0) {
            input.value = num.toLocaleString('es-MX', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        } else if (input.value.trim() !== "") {
            input.value = "0.00";
        }
        calcularLineaOperativa();
    }

    // E. Función Principal de Cálculo
    function calcularLineaOperativa() {
        const checkCompra = document.getElementById('CheckHeaderCompra')?.checked || false;
        const checkVenta = document.getElementById('CheckHeaderVenta')?.checked || false;

        const montoEfCompra = parsearMonto('PerfilCompraEfectivo');
        const montoEfVenta = parsearMonto('PerfilVentaEfectivo');
        const montoRemCompra = parsearMonto('PerfilCompraRemesa');
        const montoRemVenta = parsearMonto('PerfilVentaRemesa');

        const tieneEfectivo = (montoEfCompra > 0 || montoEfVenta > 0);
        const tieneRemesa = (montoRemCompra > 0 || montoRemVenta > 0);

        // 1. Determinar Acción
        let parteAccion = "";
        if (checkCompra && checkVenta) {
            parteAccion = "COMPRA Y VENTA";
        } else if (checkCompra) {
            parteAccion = "COMPRA";
        } else if (checkVenta) {
            parteAccion = "VENTA";
        }

        // 2. Determinar Instrumento
        let parteInstrumento = "";
        if (tieneEfectivo && tieneRemesa) {
            parteInstrumento = "EFECTIVO Y REMESA X VOLUMEN";
        } else if (tieneEfectivo) {
            parteInstrumento = "EFECTIVO";
        } else if (tieneRemesa) {
            parteInstrumento = "REMESA X VOLUMEN";
        }

        // 3. Resultado Final
        let resultadoFinal = "";
        if (parteAccion && parteInstrumento) {
            resultadoFinal = `${parteAccion} DE ${parteInstrumento}`;
        } else if (parteAccion) {
            resultadoFinal = parteAccion;
        } else if (parteInstrumento) {
            resultadoFinal = parteInstrumento;
        }

        const inputTipoOp = document.getElementById('LineaTipoOperacion');
        if (inputTipoOp) inputTipoOp.value = resultadoFinal;

        // 4. Suma Total de Montos
        const sumaTotal = montoEfCompra + montoEfVenta + montoRemCompra + montoRemVenta;
        const formatoMoneda = new Intl.NumberFormat('es-MX', {
            style: 'currency',
            currency: 'MXN',
            minimumFractionDigits: 2
        }).format(sumaTotal);

        const inputMonto = document.getElementById('LineaMontoSolicitado');
        if (inputMonto) inputMonto.value = formatoMoneda;
    }

    // F. Asignar Eventos a los Inputs de Monto (Rojos)
    const inputsMontosRojos = document.querySelectorAll(".input-monto-pesos");
    inputsMontosRojos.forEach(input => {
        input.addEventListener("input", (e) => {
            formatearCampoRojo(e.target);
            calcularLineaOperativa();
        });
        input.addEventListener("blur", (e) => {
            fijarDecimalesBlur(e.target);
        });
    });

    // G. Asignar Eventos a Checkboxes
    ['CheckHeaderCompra', 'CheckHeaderVenta'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('change', calcularLineaOperativa);
        }
    });

    // Ejecutar una vez al inicio
    calcularLineaOperativa();

});
</script>

