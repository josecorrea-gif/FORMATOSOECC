<script src="~/js/curp.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        // Concatenar Nombre Completo
        const nombre = document.getElementById('nombre');
        const paterno = document.getElementById('paterno');
        const materno = document.getElementById('materno');
        const oculto = document.getElementById('nombreCompleto');

        function actualizarNombreCompleto() {
            if (nombre && paterno && materno && oculto) {
                const partes = [nombre.value, paterno.value, materno.value]
                    .map(v => v.trim())
                    .filter(v => v.length > 0);
                oculto.value = partes.join(' ');
            }
        }

        [nombre, paterno, materno].forEach(input => {
            if (input) input.addEventListener('input', actualizarNombreCompleto);
        });

        // Concatenar CURP + 3 Dígitos
        const curp = document.getElementById('curp');
        const curp1 = document.getElementById('curp1');
        const beneficiarioCurp = document.getElementById('beneficiariocurp');

        function actualizarCurp() {
            if (curp && curp1 && beneficiarioCurp) {
                beneficiarioCurp.value = curp.value.trim() + curp1.value.trim().toUpperCase();
            }
        }

        if (curp && curp1) {
            curp.addEventListener('input', actualizarCurp);
            curp1.addEventListener('input', actualizarCurp);
        }

        // Restricción: Solo Letras
        document.querySelectorAll(".solo-letras").forEach(input => {
            input.addEventListener("input", (e) => {
                e.target.value = e.target.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
            });
        });

        // Restricción: Solo Números
        document.querySelectorAll(".solo-numeros").forEach(input => {
            input.addEventListener("input", (e) => {
                e.target.value = e.target.value.replace(/[^0-9]/g, '');
            });
        });

        // Teléfono: Formato 10 dígitos (000-000-00-00)
        const inputTelefono = document.getElementById("BeneficiarioTelefono");
        if (inputTelefono) {
            inputTelefono.addEventListener("input", (e) => {
                let num = e.target.value.replace(/\D/g, "");
                if (num.length > 10) num = num.substring(0, 10);

                let formated = "";
                if (num.length > 0) formated += num.substring(0, 3);
                if (num.length > 3) formated += "-" + num.substring(3, 6);
                if (num.length > 6) formated += "-" + num.substring(6, 8);
                if (num.length > 8) formated += "-" + num.substring(8, 10);

                e.target.value = formated;
            });
        }

        // Formato Moneda ($1,234.56)
        const inputMonto = document.getElementById("Monto");
        if (inputMonto) {
            const hiddenMonto = document.createElement("input");
            hiddenMonto.type = "hidden";
            hiddenMonto.name = inputMonto.name || "Monto";
            hiddenMonto.id = "MontoValue";
            inputMonto.insertAdjacentElement("afterend", hiddenMonto);
            inputMonto.removeAttribute("name");

            function limpiarValor(v) { return v.replace(/[^0-9.]/g, ''); }
            function actualizarHidden() { hiddenMonto.value = limpiarValor(inputMonto.value); }

            inputMonto.addEventListener("blur", (e) => {
                let valor = limpiarValor(e.target.value);
                if (valor) {
                    let num = parseFloat(valor);
                    if (!isNaN(num)) {
                        e.target.value = "$" + num.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    }
                }
                actualizarHidden();
            });

            inputMonto.addEventListener("focus", (e) => { e.target.value = limpiarValor(e.target.value); });
            inputMonto.addEventListener("input", actualizarHidden);
        }

        // Validación Mayoría de Edad (18+)
        const inputFechaNac = document.getElementById("fechaNacimiento");
        if (inputFechaNac) {
            inputFechaNac.addEventListener("change", (e) => {
                const fechaSeleccionada = new Date(e.target.value);
                const hoy = new Date();
                if (isNaN(fechaSeleccionada.getTime())) return;

                let edad = hoy.getFullYear() - fechaSeleccionada.getFullYear();
                const mes = hoy.getMonth() - fechaSeleccionada.getMonth();

                if (mes < 0 || (mes === 0 && hoy.getDate() < fechaSeleccionada.getDate())) {
                    edad--;
                }

                if (edad < 18) {
                    alert("⚠️ OPERACIÓN NO PERMITIDA: El beneficiario debe ser mayor de 18 años para realizar esta declaración.");
                    e.target.value = "";
                }
            });
        }

        // Actualizar Nombre en Firma
        const textoFirmaEstatico = document.getElementById("nombreBeneficiarioEstatico");
        function actualizarNombreFirmaEstatico() {
            const nom = nombre ? nombre.value.trim() : "";
            const pat = paterno ? paterno.value.trim() : "";
            const mat = materno ? materno.value.trim() : "";
            const completo = `${nom} ${pat} ${mat}`.trim();

            if (textoFirmaEstatico) {
                textoFirmaEstatico.textContent = completo.length > 0 ? completo.toUpperCase() : "---";
            }
        }

        [nombre, paterno, materno].forEach(input => {
            if (input) input.addEventListener("input", actualizarNombreFirmaEstatico);
        });
    });
</script>

</body>
</html>