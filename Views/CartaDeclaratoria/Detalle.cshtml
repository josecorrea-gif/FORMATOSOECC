@model CartaDeclaratoriaApp.Models.CartaDeclaratoria
@{
    ViewData["Title"] = "Detalle de Carta Declaratoria";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>Carta Declaratoria — Folio @Model.RemesaFolio</h2>
    <span class="text-muted fw-bold">
        @Html.DisplayNameFor(m => m.FechaElaboracion): @Model.FechaElaboracion.ToString("dd/MM/yyyy")
    </span>
</div>

<!-- SECCIÓN: Datos del Beneficiario -->
<fieldset class="form-section mb-4 border p-4 rounded">
    <legend class="w-auto px-2 fw-bold">Datos del Beneficiario</legend>
    
    <div class="row">
        <div class="col-md-12">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioNombreCompleto):</strong> @Model.BeneficiarioNombreCompleto</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioFechaNacimiento):</strong> @(Model.BeneficiarioFechaNacimiento?.ToString("dd/MM/yyyy"))</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioCurp):</strong> @Model.BeneficiarioCurp</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioTipoIdentificacion):</strong> @Model.BeneficiarioTipoIdentificacion</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioNumIdentificacion):</strong> @Model.BeneficiarioNumIdentificacion</p>
        </div>
        <div class="col-md-4">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioTelefono):</strong> @Model.BeneficiarioTelefono</p>
        </div>
        <div class="col-md-4">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioPaisNacimiento):</strong> @Model.BeneficiarioPaisNacimiento</p>
        </div>
        <div class="col-md-4">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioEntidadNacimiento):</strong> @Model.BeneficiarioEntidadNacimiento</p>
        </div>
        <div class="col-md-12">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioDomicilio):</strong> @Model.BeneficiarioDomicilio</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioOcupacion):</strong> @Model.BeneficiarioOcupacion</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.BeneficiarioDescripcionOcupacion):</strong> @Model.BeneficiarioDescripcionOcupacion</p>
        </div>
    </div>
</fieldset>

<!-- SECCIÓN: Datos del Girador -->
<fieldset class="form-section mb-4 border p-4 rounded">
    <legend class="w-auto px-2 fw-bold">Datos del Girador</legend>
    
    <div class="row">
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.Monto):</strong> $@Model.Monto.ToString("N2")</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.Banco):</strong> @Model.Banco</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.CuentaNumero):</strong> @Model.CuentaNumero</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.GiradorNombre):</strong> @Model.GiradorNombre</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.GiradorOcupacion):</strong> @Model.GiradorOcupacion</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.GiradorLocalidadEstado):</strong> @Model.GiradorLocalidadEstado</p>
        </div>
    </div>
</fieldset>

<!-- SECCIÓN: Declaraciones Adicionales -->
<fieldset class="form-section mb-4 border p-4 rounded">
    <legend class="w-auto px-2 fw-bold">Declaraciones Adicionales</legend>
    
    <div class="row">
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.RelacionConGirador):</strong> @Model.RelacionConGirador</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.OrigenDestinoRecursos):</strong> @Model.OrigenDestinoRecursos</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.PropietarioReal):</strong> @Model.PropietarioReal</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.PropietarioRealLocalidadEstado):</strong> @Model.PropietarioRealLocalidadEstado</p>
        </div>
    </div>
</fieldset>

<!-- SECCIÓN: Datos de Control Interno -->
<fieldset class="form-section mb-4 border p-4 rounded bg-light">
    <legend class="w-auto px-2 fw-bold text-secondary">Control Interno</legend>
    
    <div class="row text-secondary">
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.CapturadoPorUsuarioId):</strong> @Model.CapturadoPorUsuarioId</p>
        </div>
        <div class="col-md-6">
            <p><strong>@Html.DisplayNameFor(m => m.FechaCaptura):</strong> @Model.FechaCaptura.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>
</fieldset>

<!-- BOTONES DE ACCIÓN -->
<div class="mt-5 mb-5 text-center">
    <a asp-action="DescargarPdf" asp-route-id="@Model.Id" class="btn btn-primary btn-lg mx-2">
        <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
    </a>
    <a asp-action="Index" class="btn btn-secondary btn-lg mx-2">Volver al listado</a>
</div>